# Copy to .env.local for local development. Never commit real values.
# All variables are read on the server only — nothing here reaches the browser
# except the explicitly NEXT_PUBLIC_ prefixed flag at the bottom.

# --- Operating mode -------------------------------------------------------
# preview (default): noindex everywhere, drafts and placeholders visible, demo form.
# production: only confirmed content; build fails while release blockers remain
#             (npm run check:release).
SITE_MODE=preview

# Final public URL without trailing slash, e.g. https://www.example.com
# Only set once the domain is confirmed — used for canonical URLs, sitemap, Open Graph.
SITE_URL=

# --- Inquiry delivery ----------------------------------------------------------
# demo    → nothing is sent; form shows "Test request — not sent" (preview only).
# webhook → POST JSON to INQUIRY_WEBHOOK_URL (Make, Zapier, n8n, own endpoint).
# resend  → e-mail via the Resend API.
# Empty in production = form reports "unavailable" (never a faked success).
INQUIRY_DELIVERY=demo

# webhook adapter
INQUIRY_WEBHOOK_URL=
# Optional shared secret; requests carry X-Signature: sha256=<HMAC of the body>
INQUIRY_WEBHOOK_SECRET=

# resend adapter
RESEND_API_KEY=
# Inbox that receives the requests
INQUIRY_EMAIL_TO=
# Verified sender, e.g. "Website <requests@example.com>"
INQUIRY_EMAIL_FROM=

# --- Rate limiting --------------------------------------------------------------
# Shared counter for serverless/production deployments (Upstash Redis REST).
# Without it a per-instance in-memory counter is used — fine for preview only.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- Measurement ------------------------------------------------------------------
# Off until a service and its privacy notice are decided. Even when on, only
# event name + store/category/locale are passed — never personal data.
NEXT_PUBLIC_ANALYTICS_ENABLED=false
